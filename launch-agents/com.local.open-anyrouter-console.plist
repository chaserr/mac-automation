<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.open-anyrouter-console</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/open</string>
    <string>https://anyrouter.top/console</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>2</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/com.local.open-anyrouter-console.out</string>

  <key>StandardErrorPath</key>
  <string>/tmp/com.local.open-anyrouter-console.err</string>
</dict>
</plist>
